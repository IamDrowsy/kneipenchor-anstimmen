# Prevent caching of index.html and songs.json so browsers always
# validate these files with the server (304 Not Modified if unchanged).
# Vite-generated assets (JS/CSS) use content hashes and can be cached indefinitely.

<FilesMatch "^(index\.html|songs\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Long-term caching for hashed assets
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
